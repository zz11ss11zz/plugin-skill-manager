{
  "name": "plugin-skill-manager",
  "version": "0.4.6",
  "private": true,
  "type": "module",
  "description": "Inventory plugins and Skills, track usage, and identify redundancy for user-approved cleanup.",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node src/server.mjs",
    "test": "npm run build && node scripts/test.mjs",
    "setup:check": "node scripts/setup.mjs check",
    "setup:install": "node scripts/setup.mjs install",
    "setup:uninstall": "node scripts/setup.mjs uninstall",
    "build:plugin": "npm run build && node scripts/build-plugin.mjs",
    "build:marketplace": "npm run build && node scripts/build-marketplace.mjs",
    "build:distribution": "npm run build && node scripts/build-distribution.mjs"
  },
  "files": [
    "src",
    "scripts",
    "test",
    "docs",
    "dist/dashboard.html",
    "dist/revisions",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "license": "Apache-2.0"
}
