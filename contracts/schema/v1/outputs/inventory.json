{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "const": "inventory"
    },
    "scannedAt": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "path",
          "fingerprint",
          "source"
        ],
        "additionalProperties": {}
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "reason"
        ],
        "additionalProperties": {}
      }
    },
    "inventoryScope": {
      "type": "string",
      "const": "management"
    }
  },
  "required": [
    "mode",
    "scannedAt",
    "skills",
    "issues"
  ],
  "additionalProperties": {}
}
