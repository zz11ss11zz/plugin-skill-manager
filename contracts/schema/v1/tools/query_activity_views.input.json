{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requests": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "plugins",
              "skills"
            ]
          },
          "metric": {
            "type": "string",
            "enum": [
              "calls",
              "adoptions",
              "reads",
              "explicit"
            ]
          },
          "year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2100
          },
          "source": {
            "type": "string",
            "enum": [
              "host-event",
              "assistant-report"
            ]
          },
          "from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "to": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "kind",
          "metric",
          "year"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "requests"
  ],
  "additionalProperties": false
}
