{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "calls": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,160}$"
          },
          "plugin": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
          },
          "tool": {
            "type": "string",
            "maxLength": 240
          }
        },
        "required": [
          "id",
          "plugin",
          "tool"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "calls"
  ],
  "additionalProperties": false
}
